---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LogoCarouselSlot from '../components/LogoCarouselSlot.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { site } from '../data/site.js';
import { blokVoor } from '../data/rag/index.ts';
import { metRagVragen } from '../lib/rag-blok.js';
import { routeByPath, routeById } from '../data/routes';
import { t, LOCALES, DEFAULT_LOCALE, HTML_LANG, OG_LOCALE, SCHEMA_LANG, localeFromPath, otherLocale } from '../i18n';

const {
  title = `${site.brand} | ${site.name}`,
  description = 'Onafhankelijk AI-advies voor boards en leiders. Strategie, vendorselectie, governance en implementatiebegeleiding.',
  currentPath = Astro.url.pathname,
  showFooter = true,
  image = site.portrait,
  noindex = false,
  schema = null,
} = Astro.props;

const cleanPath = currentPath === '/' ? '/' : currentPath.replace(/\/$/, '');
const locale = localeFromPath(cleanPath);
const canonical = new URL(cleanPath, site.url).href;
const ogImage = new URL(image, site.url).href;
// De vragen van een RAG-blok komen ook in de structured data, als het blok daarvoor is aangezet (markup: true).
const ragBlok = blokVoor(cleanPath, locale);

// Reciproque hreflang + x-default (wijst naar EN). Alleen talen die voor deze pagina
// echt live zijn krijgen een alternate; geen counterpart betekent geen hreflang-regel.
const currentRoute = routeByPath(cleanPath, locale);
// 404 is infrastructuur zonder eigen content: geen canonical, geen hreflang, geen x-default.
// Elke taalversie van de pagina staat op haar eigen pad, zonder onderling verband voor zoekmachines.
const isErrorPage = currentRoute?.id === '404';
const alternates = isErrorPage
  ? []
  : LOCALES.filter((loc) => currentRoute?.live[loc]).map((loc) => ({
      hreflang: loc,
      href: new URL(currentRoute!.paths[loc], site.url).href,
    }));
const hasDefaultAlternate = !isErrorPage && currentRoute?.live[DEFAULT_LOCALE];

const baseSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: `${site.name}, ${site.role}`,
  url: site.url,
  image: ogImage,
  email: site.email,
  description,
  inLanguage: SCHEMA_LANG[locale],
  areaServed: ['NL', 'BE', 'DE'],
  founder: {
    '@type': 'Person',
    name: site.name,
    jobTitle: site.roleNl,
    url: site.url,
    sameAs: [site.linkedin],
  },
};
---
<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <CookieConsent />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!isErrorPage && <link rel="canonical" href={canonical} />}
    {alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    {hasDefaultAlternate && <link rel="alternate" hreflang="x-default" href={new URL(currentRoute!.paths[DEFAULT_LOCALE], site.url).href} />}
    {noindex && <meta name="robots" content={typeof noindex === 'string' ? noindex : 'noindex, nofollow'} />}
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#F3E7D2" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {currentRoute?.live[otherLocale(locale)] && <meta property="og:locale:alternate" content={OG_LOCALE[otherLocale(locale)]} />}
    <meta property="og:site_name" content={site.domain} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={locale === 'nl' ? 'Inzichten' : 'Insights'} href={locale === 'nl' ? '/nl/rss.xml' : '/rss.xml'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <script type="application/ld+json" set:html={JSON.stringify(metRagVragen(schema ?? baseSchema, ragBlok))} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale).skipLink}</a>
    <Header currentPath={currentPath} />
    <main id="main"><LogoCarouselSlot show={Astro.props.logoCarousel}><slot /></LogoCarouselSlot></main>
    {showFooter && <Footer currentPath={currentPath} />}
  </body>
</html>
