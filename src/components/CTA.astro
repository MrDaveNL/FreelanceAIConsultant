---
import { routeById } from '../data/routes';
import { site } from '../data/site.js';
const {
  locale = 'nl',
  title = locale === 'en' ? 'Ready to make your AI decisions clear?' : 'Klaar om AI-beslissingen helder te maken?',
  body = locale === 'en' ? 'Book a no-obligation call. No pitch. Just sharp questions.' : 'Plan een vrijblijvend gesprek. Geen pitch. Wel scherpe vragen.',
  eyebrow = locale === 'en' ? 'Ready for impact?' : 'Klaar voor impact?',
  note = locale === 'en' ? '30 min., no pitch deck' : '30 min., geen pitch deck',
  ctaLabel = locale === 'en' ? 'Book a call' : 'Plan een gesprek',
  // EN-fallback: mailto zolang /contact nog niet live is; volgt automatisch /contact zodra dat wel zo is.
  ctaHref = locale === 'en'
    ? (routeById('contact')?.live.en ? routeById('contact')!.paths.en : `mailto:${site.email}`)
    : '/nl/contact',
  compact = false,
} = Astro.props;
---
<section class:list={['cta', 'dark-band', compact && 'compact']}>
  <div class="container cta-inner">
    <div><p class="eyebrow">{eyebrow}</p><h2>{title}</h2><p>{body}</p></div>
    <div class="cta-side"><span class="hand">{note}</span><a class="btn" href={ctaHref}>{ctaLabel} →</a></div>
  </div>
</section>
<style>
.cta{padding:54px 0}.cta.compact{padding:38px 0}.cta-inner{display:grid;grid-template-columns:1fr auto;align-items:center;gap:40px}.cta h2{margin:0;color:white;font-size:clamp(2rem,4vw,3.4rem);line-height:1;letter-spacing:-.045em}.cta p{margin-bottom:0;color:#f0ded9}.cta .eyebrow{color:var(--salmon)}.cta-side{display:flex;align-items:center;gap:20px;flex-wrap:wrap}.cta-side .hand{font-size:1.1rem;color:#fff}
@media(max-width:760px){.cta-inner{grid-template-columns:1fr}.cta-side{justify-content:flex-start}}
</style>
