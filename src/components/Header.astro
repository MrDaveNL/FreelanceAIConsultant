---
import { site } from '../data/site.js';
import { routeById, counterpart } from '../data/routes';
import { t, localeFromPath, otherLocale, SWITCHER_LABEL } from '../i18n';
const { currentPath = '/' } = Astro.props;
const locale = localeFromPath(currentPath);
const dict = t(locale);
const homeHref = routeById('home')?.paths[locale] ?? '/';
const navIds = ['diensten', 'cases', 'werkwijze', 'inzichten', 'over'] as const;
const navItems = navIds
  .map((id) => {
    const entry = routeById(id);
    if (!entry?.live[locale]) return null;
    return [entry.paths[locale], dict.nav[id]] as const;
  })
  .filter((item): item is readonly [string, string] => item !== null);
const contactEntry = routeById('contact');
const ctaHref = contactEntry?.live[locale] ? contactEntry.paths[locale] : null;
const active = (href: string) =>
  href === homeHref ? currentPath.replace(/\/$/, '') === homeHref.replace(/\/$/, '') : currentPath.startsWith(href);
const toLocale = otherLocale(locale);
const switchHref = counterpart(currentPath, locale, toLocale) ?? routeById('home')?.paths[toLocale] ?? '/';
---
<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href={homeHref}>
      <img class="brand-logo" src="/images/freelance-ai-consultant-logo-header.png" width="600" height="287" alt={`${site.domain} logo`} />
    </a>
    <nav aria-label={dict.header.navAria}>
      {navItems.map(([href, label]) => <a class:list={['nav-link', active(href) && 'is-active']} href={href}>{label}</a>)}
      <a class="lang-switch" href={switchHref} aria-label={dict.switcherAria}>{SWITCHER_LABEL[toLocale]}</a>
    </nav>
    {ctaHref && <a class="btn nav-cta" href={ctaHref}>{dict.header.cta} <span>→</span></a>}
    <button class="menu" aria-label={dict.header.menuAria} aria-expanded="false" onclick="const h=this.closest('header');h.classList.toggle('menu-open');this.setAttribute('aria-expanded',h.classList.contains('menu-open'))">☰</button>
  </div>
</header>
<style>
.site-header{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--cream) 94%,transparent);backdrop-filter:blur(14px);border-bottom:1px solid rgba(74,31,42,.06)}
.nav-wrap{height:94px;display:grid;grid-template-columns:1.25fr auto auto;gap:34px;align-items:center}.brand{display:flex;align-items:center;width:max-content}.brand-logo{height:74px;width:auto}nav{display:flex;gap:26px;align-items:center}.nav-link{position:relative;font-size:.91rem;font-weight:700;color:#3a2928;white-space:nowrap}.nav-link::after{content:'';position:absolute;left:0;right:100%;bottom:-7px;height:2px;background:var(--burgundy);transition:right .2s}.nav-link:hover::after,.nav-link.is-active::after{right:0}.nav-cta{min-height:44px;padding-inline:18px;font-size:.78rem;white-space:nowrap}.lang-switch{font-size:.76rem;font-weight:700;letter-spacing:.04em;color:#3a2928;border:1px solid rgba(74,31,42,.25);border-radius:999px;padding:3px 10px;white-space:nowrap}.lang-switch:hover{border-color:var(--burgundy);color:var(--burgundy)}.menu{display:none;border:0;background:transparent;font-size:1.5rem;color:var(--burgundy)}
@media(max-width:900px){.nav-wrap{grid-template-columns:1fr auto;height:76px}.site-header nav,.nav-cta{display:none}.menu{display:block}.menu-open .nav-wrap{height:auto;padding-block:18px;grid-template-columns:1fr auto}.menu-open nav{display:flex;grid-column:1/-1;flex-direction:column;align-items:flex-start;padding:12px 0}.menu-open .nav-cta{display:inline-flex;grid-column:1/-1;width:max-content}.brand-logo{height:58px}}
</style>
