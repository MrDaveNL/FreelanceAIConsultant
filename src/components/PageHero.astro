---
import HeroPortrait from './HeroPortrait.astro';
import { routeById } from '../data/routes';
import { site } from '../data/site.js';
const {
  locale = 'nl',
  eyebrow,
  title,
  marked,
  body,
  cta = locale === 'en' ? 'Book a call' : 'Plan een gesprek',
  // EN-fallback: mailto zolang /contact nog niet live is; volgt automatisch /contact zodra dat wel zo is.
  ctaHref = locale === 'en'
    ? (routeById('contact')?.live.en ? routeById('contact')!.paths.en : `mailto:${site.email}`)
    : '/nl/contact',
  secondary,
  secondaryHref = '#',
  compact = false,
  note = locale === 'en' ? '30 min., no pitch deck' : '30 min., geen pitch deck',
} = Astro.props;

const index = marked ? title.indexOf(marked) : -1;
const before = index >= 0 ? title.slice(0, index) : title;
const after = index >= 0 ? title.slice(index + marked.length) : '';
---
<section class:list={['page-hero', compact && 'compact']}>
  <div class="container hero-grid">
    <div class="copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="h1">{before}{index >= 0 && <span class="marker">{marked}</span>}{after}</h1>
      {body && <p class="lede">{body}</p>}
      <div class="actions">
        <a class="btn" href={ctaHref}>{cta} →</a>
        {secondary && <a class="text-link" href={secondaryHref}>{secondary} →</a>}
        {note && <span class="hand micro">{note}</span>}
      </div>
    </div>
    <HeroPortrait compact={compact} locale={locale} />
  </div>
</section>
<style>
.page-hero{padding:38px 0 50px}.page-hero.compact{padding-bottom:32px}.hero-grid{display:grid;grid-template-columns:1.04fr .96fr;gap:34px;align-items:center}.copy{padding:48px 0 20px}.lede{margin:26px 0 26px;max-width:610px}.actions{display:flex;align-items:center;flex-wrap:wrap;gap:22px}.micro{font-size:1rem;transform:rotate(-1deg);border-bottom:2px solid var(--burgundy)}
@media(max-width:900px){.hero-grid{grid-template-columns:1fr}.copy{padding-top:24px}.page-hero{padding-top:10px}}
</style>
