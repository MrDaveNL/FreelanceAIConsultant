---
import { steps } from '../data/process.js';
const { compact = false } = Astro.props;
---
<div class:list={['steps', compact && 'compact']}>
  {steps.map(([n, t, d, i]) => (
    <div class="step">
      <span class="step-num">{n}</span>
      <div class="step-icon" aria-hidden="true">{i}</div>
      <h3>{t}</h3>
      <p>{d}</p>
    </div>
  ))}
</div>
<style>
.steps{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:16px;overflow:hidden;background:rgba(255,250,241,.64)}.step{position:relative;padding:26px 24px;min-height:240px;border-right:1px solid var(--line)}.step:last-child{border-right:0}.step-num{width:28px;height:28px;border-radius:50%;background:var(--burgundy);color:white;display:grid;place-items:center;font-size:.72rem;font-weight:800}.step-icon{font-size:3rem;margin:22px 0 16px;color:var(--burgundy)}.step h3{margin:0 0 8px;color:var(--burgundy);font-size:1.08rem}.step p{font-size:.83rem;margin:0;color:#52443f}.compact .step{min-height:205px}
@media(max-width:800px){.steps{grid-template-columns:1fr 1fr}.step:nth-child(2){border-right:0}.step{border-bottom:1px solid var(--line)}}@media(max-width:520px){.steps{grid-template-columns:1fr}.step{border-right:0}}
</style>
