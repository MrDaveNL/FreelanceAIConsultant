---
const { filters = [], target, center = false } = Astro.props;
---
<div class:list={['filters', center && 'is-center']} data-filter-target={target}>
  {filters.map((f, i) => (
    <button type="button" class:list={['filter-btn', i === 0 && 'active']} data-filter={i === 0 ? '*' : f}>{f}</button>
  ))}
</div>
<p class="filter-empty" data-filter-empty={target} hidden>Geen resultaten in deze categorie.</p>
<script>
  document.querySelectorAll('[data-filter-target]').forEach((bar) => {
    const targetSel = bar.getAttribute('data-filter-target');
    const grid = document.querySelector(targetSel);
    if (!grid) return;
    const empty = document.querySelector(`[data-filter-empty="${targetSel}"]`);
    bar.addEventListener('click', (event) => {
      const btn = event.target.closest('.filter-btn');
      if (!btn) return;
      bar.querySelectorAll('.filter-btn').forEach((b) => b.classList.toggle('active', b === btn));
      const value = btn.getAttribute('data-filter');
      let visible = 0;
      grid.querySelectorAll('[data-category], [data-sector]').forEach((card) => {
        const key = card.getAttribute('data-category') ?? card.getAttribute('data-sector');
        const show = value === '*' || key === value;
        card.hidden = !show;
        if (show) visible += 1;
      });
      if (empty) empty.hidden = visible !== 0;
    });
  });
</script>
<style>
.filters{display:flex;gap:10px;flex-wrap:wrap}.filters.is-center{justify-content:center}.filter-btn{border:1px solid var(--burgundy);border-radius:999px;padding:9px 17px;background:transparent;color:var(--burgundy);font-weight:700;cursor:pointer;transition:background .18s ease,color .18s ease}.filter-btn:hover{background:rgba(74,31,42,.08)}.filter-btn.active{background:var(--burgundy);color:white}.filter-empty{margin-top:26px;color:var(--muted)}
</style>
