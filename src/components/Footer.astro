---
import { site } from '../data/site.js';
import { hubLinks } from '../data/protected-urls.js';
import { routeById } from '../data/routes';
import { t, localeFromPath } from '../i18n';
const { currentPath = '/' } = Astro.props;
const locale = localeFromPath(currentPath);
const dict = t(locale);
const year = new Date().getFullYear();
const href = (id: string) => {
  const entry = routeById(id);
  return entry?.live[locale] ? entry.paths[locale] : null;
};
const servicesLinks = [
  ['svc-ai-readiness-assessment', 'AI Readiness Assessment'],
  ['svc-ai-strategy-sprint', 'AI Strategy Sprint'],
  ['svc-fractional-ai-lead', 'Fractional AI Lead'],
] as const;
// Volgorde moet exact overeenkomen met hubLinks in src/data/protected-urls.js.
const hubRouteIds = ['C1-00', 'C2-00', 'C3-00', 'C4-00', 'C5-00', 'C6-00', 'C8-00', 'C9-00', 'C7-00', 'P08', 'P04', 'P06'];
const hubLinksLocalized = hubLinks
  .map(([, label], i) => {
    const entry = routeById(hubRouteIds[i]);
    const path = entry?.live[locale] ? entry.paths[locale] : null;
    return path ? [path, label] : null;
  })
  .filter((item): item is [string, string] => item !== null);
---
<footer class="footer dark-band">
  <div class="container footer-grid">
    <div>
      <img class="footer-icon" src="/images/freelance-ai-consultant-icon-footer.png" width="192" height="192" alt="" loading="lazy" />
      <strong>{site.nameUpper}</strong>
      <span>{site.role}</span>
      <em>{site.domain}</em>
    </div>
    <div>
      <b>{dict.footer.servicesHeading}</b>
      {servicesLinks.map(([id, label]) => href(id) && <a href={href(id)}>{label}</a>)}
      {href('diensten') && <a href={href('diensten')}>{dict.footer.allServices}</a>}
    </div>
    <div>
      <b>{dict.footer.contentHeading}</b>
      {href('cases') && <a href={href('cases')}>{dict.nav.cases}</a>}
      {href('werkwijze') && <a href={href('werkwijze')}>{dict.nav.werkwijze}</a>}
      {href('inzichten') && <a href={href('inzichten')}>{dict.nav.inzichten}</a>}
      {href('veelgestelde-vragen') && <a href={href('veelgestelde-vragen')}>{dict.footer.faq}</a>}
      {href('over') && <a href={href('over')}>{dict.nav.over}</a>}
    </div>
    <div>
      <b>{dict.footer.hubHeading}</b>
      {hubLinksLocalized.map(([path, label]) => <a href={path}>{label}</a>)}
    </div>
    <div>
      <b>{dict.footer.contactHeading}</b>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.linkedin} rel="noopener">{dict.footer.linkedin}</a>
      {href('contact') && <a href={href('contact')}>{dict.footer.cta}</a>}
    </div>
  </div>
  <div class="container legal">
    <span>© {year} {site.domain}</span>
    {href('privacy') && <a href={href('privacy')}>{dict.footer.privacy}</a>}
    {href('algemene-voorwaarden') && <a href={href('algemene-voorwaarden')}>{dict.footer.terms}</a>}
    <span>{site.legal.entity} · KvK {site.legal.kvk}</span>
  </div>
</footer>
<style>
.footer{padding:58px 0 24px}.footer-grid{display:grid;grid-template-columns:1.4fr repeat(4,1fr);gap:44px}.footer-grid>div{display:flex;flex-direction:column;gap:8px}.footer-icon{box-sizing:border-box;width:76px;height:76px;padding:9px;background:var(--cream);border-radius:16px;object-fit:contain;margin-bottom:10px}.footer strong{font-size:1.05rem}.footer span,.footer a{font-size:.84rem;color:#f5e8df}.footer a:hover{color:var(--mustard)}.footer em{font-family:'Caveat',cursive;color:var(--salmon);font-size:1.18rem;font-style:normal}.footer b{color:var(--mustard);font-size:.78rem;text-transform:uppercase;letter-spacing:.07em;margin-bottom:5px}.legal{display:flex;gap:28px;padding-top:34px;margin-top:34px;border-top:1px solid rgba(255,255,255,.12);font-size:.76rem;color:#d9c9c6;flex-wrap:wrap}.legal a{font-size:.76rem}
@media(max-width:760px){.footer-grid{grid-template-columns:1fr 1fr}.footer-grid>div:first-child{grid-column:1/-1}.legal{flex-direction:column;gap:8px}}
</style>
