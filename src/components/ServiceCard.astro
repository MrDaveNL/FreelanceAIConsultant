---
const { service, number, title, text, timing, price, tone = 'yellow', href = '#', locale = 'nl' } = Astro.props;
const s = service ?? { number, title, cardText: text, timing, price, tone, slug: null };
const link = service ? (service.lang === 'en' ? `/services/${service.slug}` : `/nl/diensten/${service.slug}`) : href;
const lang = service?.lang ?? locale;
const ctaLabel = lang === 'en' ? 'Request a proposal' : 'Vraag een voorstel aan';
---
<a class:list={['service-card', `tone-${s.tone}`]} href={link}>
  <span class="num">{s.number}</span>
  <h3>{s.title}</h3>
  <p>{s.cardText}</p>
  <div class="bottom"><small>{s.cardTiming ?? s.timing}</small><span class="price-link">{ctaLabel}</span><span aria-hidden="true">→</span></div>
</a>
<style>
.service-card{min-height:310px;padding:28px;border-radius:14px;display:flex;flex-direction:column;border:1px solid rgba(74,31,42,.08);transition:transform .2s ease;box-shadow:0 12px 30px rgba(74,31,42,.04)}.service-card:hover{transform:translateY(-5px)}.tone-yellow{background:var(--mustard)}.tone-aqua{background:var(--aqua)}.tone-salmon{background:var(--salmon)}.tone-sand{background:var(--sand)}.num{font-weight:800}.service-card h3{font-size:1.75rem;line-height:.95;letter-spacing:-.04em;margin:8px 0 16px;color:var(--burgundy)}.service-card p{font-size:.9rem;max-width:300px}.bottom{display:grid;grid-template-columns:1fr auto auto;gap:10px;align-items:end;margin-top:auto;border-top:1px solid rgba(74,31,42,.22);padding-top:14px}.price-link{font-weight:700;font-size:.78rem;text-decoration:underline;text-underline-offset:3px}.bottom span[aria-hidden]{font-size:1.4rem}
</style>
