---
// GTM + Consent Mode v2 + de cookiebanner (vanilla-cookieconsent). Eén plek, in BaseLayout, dus
// actief op elke EN- en NL-pagina inclusief beide 404's. Alleen actief in productie en alleen als
// PUBLIC_GTM_ID gezet is (zie .env.example) - zie planning/decisions-analytics-consent.md voor de
// afweging. Zonder GTM-ID is er niets om toestemming voor te vragen, dus blijft de banner ook weg.
import 'vanilla-cookieconsent/dist/cookieconsent.css';

const gtmId = import.meta.env.PUBLIC_GTM_ID;
const enabled = import.meta.env.PROD && Boolean(gtmId);
---
{enabled && (
  <>
    {/* 1. Consent-default, vóór GTM. Leest een eerder opgeslagen keuze (cookie "cc_cookie") en
        stuurt die meteen door, zodat een terugkerende bezoeker niet op wait_for_update wacht. */}
    <script is:inline define:vars={{ gtmId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500,
      });
      (function () {
        try {
          var match = document.cookie.match('(^|; )cc_cookie=([^;]*)');
          if (!match) return;
          var stored = JSON.parse(decodeURIComponent(match[2]));
          var categories = (stored && stored.categories) || [];
          var granted = categories.indexOf('analytics') !== -1;
          gtag('consent', 'update', { analytics_storage: granted ? 'granted' : 'denied' });
        } catch (e) {
          // Geen of onleesbare cookie: default-status (denied) blijft staan.
        }
      })();
    </script>
    {/* 2. Het officiele GTM-snippet (met gtm.start-event). Geen noscript-iframe: die laadt zonder
        consent-check. */}
    <script is:inline define:vars={{ gtmId }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0], j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', gtmId);
    </script>
    {/* 3. De cookiebanner zelf. Leest de taal uit html[lang], dus altijd in lijn met de rest van
        de pagina. */}
    <script>
      import * as CookieConsent from 'vanilla-cookieconsent';

      const gaCookieTable = (ga, gaSession) => ({
        headers: { name: 'name', domain: 'domain', desc: 'desc' },
        body: [
          { name: '_ga', domain: location.hostname, desc: ga },
          { name: '_ga_<container-id>', domain: location.hostname, desc: gaSession },
        ],
      });

      const translations = {
        nl: {
          consentModal: {
            title: 'We gebruiken cookies',
            description:
              'Noodzakelijke cookies houden de site werkend. Analytische cookies (Google Analytics, via Google Tag Manager) plaatsen we alleen als je daarvoor toestemming geeft. Lees meer in de <a href="/nl/privacy">privacyverklaring</a>.',
            acceptAllBtn: 'Alles accepteren',
            acceptNecessaryBtn: 'Alles weigeren',
            showPreferencesBtn: 'Voorkeuren',
          },
          preferencesModal: {
            title: 'Cookie-voorkeuren',
            acceptAllBtn: 'Alles accepteren',
            acceptNecessaryBtn: 'Alles weigeren',
            savePreferencesBtn: 'Voorkeuren opslaan',
            closeIconLabel: 'Sluiten',
            serviceCounterLabel: 'dienst(en)',
            sections: [
              {
                title: 'Hoe we cookies gebruiken',
                description:
                  'Je kunt per categorie kiezen. Noodzakelijke cookies staan altijd aan, de rest alleen als je daarvoor toestemming geeft. Je kunt je keuze altijd aanpassen via "Cookie-instellingen" onderin de pagina.',
              },
              {
                title: 'Noodzakelijk',
                description: 'Nodig om de site te laten werken, bijvoorbeeld om je cookiekeuze te onthouden. Kan niet worden uitgezet.',
                linkedCategory: 'necessary',
              },
              {
                title: 'Analytisch',
                description: 'Google Analytics (via Google Tag Manager) meet bezoekersgedrag zodat we de site kunnen verbeteren. Staat standaard uit.',
                linkedCategory: 'analytics',
                cookieTable: gaCookieTable('Onderscheidt bezoekers (Google Analytics)', 'Onthoudt sessiestatus (Google Analytics)'),
              },
            ],
          },
        },
        en: {
          consentModal: {
            title: 'We use cookies',
            description:
              'Necessary cookies keep the site working. Analytics cookies (Google Analytics, via Google Tag Manager) are only set if you consent. Read more in the <a href="/privacy">privacy policy</a>.',
            acceptAllBtn: 'Accept all',
            acceptNecessaryBtn: 'Reject all',
            showPreferencesBtn: 'Preferences',
          },
          preferencesModal: {
            title: 'Cookie preferences',
            acceptAllBtn: 'Accept all',
            acceptNecessaryBtn: 'Reject all',
            savePreferencesBtn: 'Save preferences',
            closeIconLabel: 'Close',
            serviceCounterLabel: 'service(s)',
            sections: [
              {
                title: 'How we use cookies',
                description:
                  'You can choose per category. Necessary cookies are always on, the rest only with your consent. You can change your choice any time via "Cookie settings" in the footer.',
              },
              {
                title: 'Necessary',
                description: 'Needed to make the site work, for example to remember your cookie choice. Cannot be switched off.',
                linkedCategory: 'necessary',
              },
              {
                title: 'Analytics',
                description: 'Google Analytics (via Google Tag Manager) measures visitor behaviour so we can improve the site. Off by default.',
                linkedCategory: 'analytics',
                cookieTable: gaCookieTable('Distinguishes visitors (Google Analytics)', 'Remembers session state (Google Analytics)'),
              },
            ],
          },
        },
      };

      function pushConsentUpdate(cookie) {
        const categories = cookie.categories || [];
        const analyticsGranted = categories.indexOf('analytics') !== -1;
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('consent', 'update', { analytics_storage: analyticsGranted ? 'granted' : 'denied' });
        window.dataLayer.push({ event: 'consent_update', categories, analytics_storage: analyticsGranted ? 'granted' : 'denied' });
      }

      const htmlLocale = document.documentElement.lang === 'nl' ? 'nl' : 'en';

      CookieConsent.run({
        guiOptions: {
          consentModal: { layout: 'box', position: 'bottom left', equalWeightButtons: true, flipButtons: false },
          preferencesModal: { layout: 'box', equalWeightButtons: true, flipButtons: false },
        },
        cookie: { name: 'cc_cookie', expiresAfterDays: 365 },
        revision: 0,
        categories: {
          necessary: { readOnly: true },
          analytics: {
            autoClear: { cookies: [{ name: /^_ga/ }], reloadPage: true },
          },
        },
        language: {
          default: htmlLocale,
          translations,
        },
        onFirstConsent: ({ cookie }) => pushConsentUpdate(cookie),
        onChange: ({ cookie }) => pushConsentUpdate(cookie),
      });
    </script>
  </>
)}
{enabled && (
  <style is:global>
    /* Huisstijlkleuren uit src/styles/global.css, geen nieuwe kleuren. Accepteren en weigeren
       krijgen evenveel gewicht: zelfde opmaak, alleen een ander accentkleur. */
    #cc-main {
      --cc-font-family: 'Space Grotesk', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --cc-bg: var(--white);
      --cc-primary-color: var(--ink);
      --cc-secondary-color: var(--muted);
      --cc-btn-primary-bg: var(--burgundy);
      --cc-btn-primary-color: var(--white);
      --cc-btn-primary-border-color: var(--burgundy);
      --cc-btn-primary-hover-bg: var(--burgundy-deep);
      --cc-btn-primary-hover-color: var(--white);
      --cc-btn-primary-hover-border-color: var(--burgundy-deep);
      --cc-btn-secondary-bg: var(--mustard);
      --cc-btn-secondary-color: var(--burgundy-deep);
      --cc-btn-secondary-border-color: var(--mustard);
      --cc-btn-secondary-hover-bg: var(--mustard-deep);
      --cc-btn-secondary-hover-color: var(--burgundy-deep);
      --cc-btn-secondary-hover-border-color: var(--mustard-deep);
      --cc-toggle-on-bg: var(--burgundy);
      --cc-toggle-off-bg: var(--line);
      --cc-toggle-readonly-bg: var(--sand);
      --cc-link-color: var(--burgundy);
      --cc-overlay-bg: rgba(42, 23, 32, .55);
      --cc-modal-border-radius: var(--radius);
      --cc-btn-border-radius: 10px;
      --cc-z-index: 9999;
    }
  </style>
)}
