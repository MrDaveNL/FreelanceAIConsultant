---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CTA from '@/components/CTA.astro';
import { site, principles } from '@/data/site.js';

const timeline = [
  ['Sinds 2006', 'Strategie, digital en innovatie, aan klant- én leverancierszijde'],
  ['100+ trajecten', 'Van AI-strategie en vendorselectie tot implementatiebegeleiding'],
  ['Executive sparringpartner', 'Voor CIO’s, CFO’s, CEO’s en raden van commissarissen'],
  ['Publicist & spreker', 'Over AI, leiderschap en verandermanagement'],
];

const career = [
  ['Nu', 'Onafhankelijk AI-adviseur', 'Strategie, vendorselectie, governance en fractional AI-leiderschap voor organisaties in Nederland, België en Duitsland.'],
  ['Daarvoor', 'Leidinggevende rollen in digital & data', 'Verantwoordelijk voor datagedreven programma’s in grotere organisaties. Hier leerde ik hoe veel goede plannen stranden op eigenaarschap en beheer, niet op techniek.'],
  ['Daarvoor', 'Consultancy en leverancierszijde', 'Aan de andere kant van de tafel gezeten. Dat is precies de reden dat ik nu geen commissies of partnerdeals accepteer: ik weet hoe die het advies sturen.'],
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.roleNl,
  url: `${site.url}/nl/over`,
  email: site.email,
  image: new URL(site.portrait, site.url).href,
  sameAs: [site.linkedin],
  knowsAbout: ['AI-strategie', 'AI-governance', 'Vendorselectie', 'Datagedreven werken', 'Digitale transformatie'],
};
---
<BaseLayout
  title={`Over ${site.firstName} | ${site.brand}`}
  description={`${site.name} is onafhankelijk AI-adviseur. Sinds 2006 in search, sinds 2021 bouw ik AI-tools en automatiseringen. Geen vendorbelangen.`}
  schema={schema}
>
  <PageHero
    compact
    eyebrow="Over mij"
    title={`Hi, ik ben ${site.firstName}. Onafhankelijk AI-adviseur voor boards en leiders die vooruit willen.`}
    marked="Onafhankelijk"
    body="Ik help organisaties AI-beslissingen nemen die waarde creëren, risico’s beperken en écht passen bij hun strategie. Geen verkooppraat. Geen tool-voorkeuren. Wel helder advies, scherpe keuzes en begeleiding van mens tot proces."
    secondary="Neem contact op"
    secondaryHref="/nl/contact"
  />

  <section class="section-sm story">
    <div class="container story-grid">
      <div>
        <p class="eyebrow">Mijn verhaal</p>
        <h2 class="h2">Van strategie naar uitvoering.<br/>Met <span class="marker">impact.</span></h2>
        <p>Sinds 2006 werk ik in strategie, digital en innovatie aan klant- én leverancierszijde, en zag ik steeds hetzelfde patroon: goede intenties, maar vage keuzes. Tools vóór strategie. Hype vóór waarde. En adviseurs die meeverdienden aan de oplossing die ze aanraadden.</p>
        <p>Ik startte {site.domain} om daar verandering in te brengen. Ik werk zelfstandig, onafhankelijk en altijd in jouw belang. Eén senior adviseur. Geen juniors op je project. Geen ruis.</p>
        <p>Dat betekent ook dat ik niet alles kan. Grote implementatieprogramma’s, teams van tien ontwikkelaars, wereldwijde uitrol: daar ben ik de verkeerde partij voor, en dat zeg ik dan ook.</p>
      </div>
      <div>
        <p class="eyebrow">Ervaring in het kort</p>
        <div class="timeline">
          {timeline.map(([value, label]) => (
            <div><span class="icon-dot" aria-hidden="true">✓</span><p><b>{value}</b><br/>{label}</p></div>
          ))}
        </div>
      </div>
      <div>
        <p class="eyebrow">Waar ik in geloof</p>
        {principles.map(([title, text]) => (
          <div class="belief"><span class="icon-dot" aria-hidden="true">✓</span><div><b>{title}</b><p>{text}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm career">
    <div class="container career-grid">
      <div>
        <p class="eyebrow">Achtergrond</p>
        <h2 class="h2">Waar deze<br/><span class="marker">ervaring</span><br/>vandaan komt.</h2>
      </div>
      <div class="career-list">
        {career.map(([period, role, text]) => (
          <div class="career-row">
            <span class="period">{period}</span>
            <div><b>{role}</b><p>{text}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm personal">
    <div class="container personal-grid">
      <div class="card personal-card">
        <p class="eyebrow">Hoe ik werk in de praktijk</p>
        <ul class="checks">
          <li>Ik zeg het als ik denk dat je me niet nodig hebt.</li>
          <li>Ik schrijf zelf. Alles wat je van mij krijgt, heb ik zelf gemaakt en kan ik verdedigen.</li>
          <li>Ik werk aan maximaal drie opdrachten tegelijk, zodat aandacht geen schaars goed wordt.</li>
          <li>Ik neem nooit twee directe concurrenten tegelijk aan.</li>
          <li>Na drie maanden kom ik terug om te kijken of het beloofde resultaat er ook echt is.</li>
        </ul>
      </div>
      <div class="card personal-card alt">
        <p class="eyebrow">Buiten het werk</p>
        <p>Ik lees veel over besluitvorming en risico, vakgebieden waar AI verrassend weinig van heeft geleerd. Verder hardlopen, koken en met enige regelmaat de fout ingaan met zelfbouwprojecten in huis.</p>
        <p>Spreken doe ik ook: over AI-besluitvorming, governance en waarom de meeste pilots blijven steken. Liever een scherp gesprek met twintig mensen dan een keynote voor vijfhonderd.</p>
        <a class="text-link" href="/nl/contact">Vraag naar beschikbaarheid →</a>
      </div>
    </div>
  </section>

  <section class="section-sm contact-teaser">
    <div class="container teaser-box dark-band">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 class="h2">Laten we <span class="underline">kennismaken.</span></h2>
        <p>{site.availability}</p>
      </div>
      <div class="teaser-links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.linkedin} rel="noopener">LinkedIn ↗</a>
        <a class="btn" href="/nl/contact">Naar het contactformulier →</a>
      </div>
    </div>
  </section>

  <CTA title="Plan een vrijblijvend gesprek." body="30 minuten. Online. Geen pitch deck. Wel waarde." />
</BaseLayout>
<style>
.story{background:var(--cream-2)}
.story-grid{display:grid;grid-template-columns:1.15fr .85fr .85fr;gap:40px}
.story p{font-size:.94rem}
.timeline>div,.belief{display:grid;grid-template-columns:auto 1fr;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line)}
.timeline p,.belief p{margin:0;font-size:.82rem}
.belief b{color:var(--burgundy)}
.career-grid{display:grid;grid-template-columns:.5fr 1.5fr;gap:44px;align-items:start}
.career-row{display:grid;grid-template-columns:auto 1fr;gap:24px;padding:22px 0;border-bottom:1px solid var(--line)}
.career-row .period{font-family:'Caveat',cursive;font-weight:700;color:var(--salmon);font-size:1.2rem;min-width:88px}
.career-row b{color:var(--burgundy);font-size:1.08rem}
.career-row p{margin:6px 0 0;font-size:.88rem}
.personal-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.personal-card{padding:32px;box-shadow:none}
.personal-card.alt{background:var(--sand)}
.personal-card p{font-size:.9rem}
.teaser-box{display:grid;grid-template-columns:1.2fr .8fr;gap:40px;padding:44px;border-radius:22px;align-items:center}
.teaser-box .eyebrow{color:var(--salmon)}
.teaser-box p{color:#f0ded9;margin-bottom:0}
.teaser-links{display:flex;flex-direction:column;gap:12px;align-items:flex-start}
.teaser-links a{color:#f5e8df;font-size:.92rem}
.teaser-links .btn{color:var(--burgundy-deep);margin-top:10px}
@media(max-width:1000px){.story-grid{grid-template-columns:1fr 1fr}.story-grid>div:first-child{grid-column:1/-1}}
@media(max-width:820px){.story-grid,.career-grid,.personal-grid,.teaser-box{grid-template-columns:1fr}.teaser-box{padding:28px}}
</style>
