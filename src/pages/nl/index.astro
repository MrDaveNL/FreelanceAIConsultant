---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import MetricStrip from '@/components/MetricStrip.astro';
import Comparison from '@/components/Comparison.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import Steps from '@/components/Steps.astro';
import CaseCard from '@/components/CaseCard.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import CTA from '@/components/CTA.astro';
import { site, metrics, independence } from '@/data/site.js';
import { testimonials } from '@/data/cases.js';

const featuredServices = (await getCollection('services', ({ data }) => data.lang === 'nl' && data.featured)).map((s) => s.data);
const allCases = (await getCollection('cases', ({ data }) => data.lang === 'nl')).map((c) => c.data);
const allArticles = (await getCollection('articles', ({ data }) => data.lang === 'nl')).map((a) => a.data);
const homeCases = allCases.slice(0, 3);
const homeArticles = allArticles
  .slice()
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 4);
const description = `Onafhankelijk AI-advies van ${site.name}, freelance AI consultant. Ik help bepalen waar AI waarde creëert, welke leveranciers passen en hoe pilots slagen.`;
---
<BaseLayout title={`${site.brand} | ${site.name}`} description={description}>
  <PageHero
    eyebrow="AI-advies dat je helpt beslissen"
    title="Maak de AI-beslissingen die je aan je board moet uitleggen."
    marked="AI-beslissingen"
    body="Ik help CIO's, CDO's en AI-leads bepalen waar AI wél waarde creëert, welke leveranciers daarbij passen en hoe je voorkomt dat pilots dure zijprojecten worden."
    secondary="Bekijk cases"
    secondaryHref="/nl/cases"
  />

  <MetricStrip items={metrics} />

  <Comparison />

  <section class="section services">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Hoe ik help</p>
          <h2 class="h2">Drie manieren om <span class="marker">verder te komen.</span></h2>
        </div>
        <a class="text-link" href="/nl/diensten">Alle diensten →</a>
      </div>
      <div class="service-grid">
        {featuredServices.map((service) => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>

  <section class="section-sm how">
    <div class="container how-grid">
      <div>
        <p class="eyebrow">How I work</p>
        <h2 class="h2">Geen 200-slide deck.</h2>
        <p class="lede">Wel <span class="marker">vier duidelijke beslismomenten.</span></p>
        <a class="text-link" href="/nl/werkwijze">Bekijk mijn werkwijze →</a>
      </div>
      <Steps compact={true} />
    </div>
  </section>

  <section class="section cases-preview">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Recent work</p>
          <h2 class="h2">Werk dat <span class="marker">het verschil</span> maakt.</h2>
        </div>
        <a class="text-link" href="/nl/cases">Alle cases →</a>
      </div>
      <div class="grid-3">
        {homeCases.map((item) => <CaseCard item={item} />)}
      </div>
    </div>
  </section>

  <section class="section-sm quotes-band">
    <div class="container">
      <p class="eyebrow">Wat opdrachtgevers zeggen</p>
      <div class="grid-3 quotes">
        {testimonials.map((quote) => (
          <blockquote>“{quote.text}”<cite>{quote.author}</cite></blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="section ethics">
    <div class="container ethics-card">
      <div>
        <p class="eyebrow">My independence commitment</p>
        <h2 class="h2">Ik verdien niet meer als jij meer software koopt.</h2>
        <p>Mijn inkomsten komen volledig uit adviesuren die jij betaalt. Geen enkele leverancier betaalt mij iets, in geen enkele vorm. Dat is de reden dat ik “nee, niet kopen” kan adviseren zonder dat het mij geld kost.</p>
      </div>
      <ul>{independence.map((item) => <li>{item}</li>)}</ul>
      <a class="btn btn--ghost" href="/nl/werkwijze">Bekijk mijn werkwijze →</a>
    </div>
  </section>

  <section class="section-sm insights-preview">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Inzichten</p>
          <h2 class="h2">Lezen voordat je <span class="marker">beslist.</span></h2>
        </div>
        <a class="text-link" href="/nl/inzichten">Alle inzichten →</a>
      </div>
      <div class="grid-4">
        {homeArticles.map((item) => <ArticleCard item={item} />)}
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
<style>
.service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.how{background:var(--cream-2)}
.how-grid{display:grid;grid-template-columns:.42fr 1.58fr;gap:44px;align-items:center}
.how-grid .text-link{display:inline-block;margin-top:8px}
.quotes-band{background:var(--cream-2)}
blockquote{margin:0;font-family:'Caveat',cursive;font-size:1.5rem;line-height:1.1;color:var(--burgundy);padding:22px 26px;border-left:4px solid var(--salmon)}
cite{display:block;font-family:'Space Grotesk',sans-serif;font-style:normal;font-size:.74rem;color:var(--muted);margin-top:16px}
.ethics-card{display:grid;grid-template-columns:1.2fr .8fr;gap:34px;background:rgba(255,250,241,.7);border:1px solid var(--line);padding:44px;border-radius:22px}
.ethics-card p{max-width:520px}
.ethics-card ul{margin:0;padding:0;list-style:none}
.ethics-card li{padding:11px 0;border-bottom:1px solid var(--line);font-weight:600}
.ethics-card li::before{content:'✓';display:inline-grid;place-items:center;width:23px;height:23px;border-radius:50%;background:var(--burgundy);color:white;margin-right:10px;font-size:.72rem}
.ethics-card .btn{grid-column:1/-1;width:max-content}
@media(max-width:900px){.service-grid{grid-template-columns:1fr}.how-grid{grid-template-columns:1fr}.ethics-card{grid-template-columns:1fr;padding:28px}}
</style>
