---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import { site, principlesEn, availabilityEn } from '../data/site.js';
import { routeById } from '../data/routes';

const contactEntry = routeById('contact');
const contactLive = Boolean(contactEntry?.live.en);
const contactHref = contactLive ? contactEntry!.paths.en : `mailto:${site.email}`;

const timeline = [
  ['Since 2006', 'Strategy, digital and innovation, on both the client and vendor side'],
  ['100+ engagements', 'From AI strategy and vendor selection to implementation guidance'],
  ['Executive sparring partner', 'For CIOs, CFOs, CEOs and supervisory boards'],
  ['Published & speaker', 'On AI, leadership and change management'],
];

const career = [
  ['Now', 'Independent AI advisor', 'Strategy, vendor selection, governance and fractional AI leadership for organizations in the Netherlands, Belgium and Germany.'],
  ['Before that', 'Leadership roles in digital & data', 'Responsible for data-driven programs in larger organizations. This is where I learned how many good plans fail on ownership and management, not on technology.'],
  ['Before that', 'Consulting and vendor side', 'Sat on the other side of the table. That is exactly why I now accept no commissions or partner deals: I know how those steer the advice.'],
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: `${site.url}/about`,
  email: site.email,
  image: new URL(site.portrait, site.url).href,
  sameAs: [site.linkedin],
  knowsAbout: ['AI strategy', 'AI governance', 'Vendor selection', 'Data-driven operations', 'Digital transformation'],
};
---
<BaseLayout
  title={`${site.name} | AI Consultant`}
  description={`${site.name} is an independent AI consultant for boards and leaders. In strategy, digital and innovation since 2006. No vendor interests.`}
  schema={schema}
>
  <PageHero
    locale="en"
    compact
    eyebrow="About me"
    title={`Hi, I'm ${site.name}. Independent AI consultant for boards and leaders who want to move forward.`}
    marked={site.name}
    body="I help organizations make AI decisions that create value, limit risk, and actually fit their strategy. No sales pitch. No tool preferences. Just clear advice, sharp choices, and guidance from people to process."
    secondary="Get in touch"
    secondaryHref={contactHref}
  />

  <section class="section-sm story">
    <div class="container story-grid">
      <div>
        <p class="eyebrow">My story</p>
        <h2 class="h2">From strategy to execution.<br/>With <span class="marker">impact.</span></h2>
        <p>After twenty years in strategy, digital and innovation, on both the client and vendor side, I kept seeing the same pattern: good intentions, vague choices. Tools before strategy. Hype before value. And advisors who profited from the very solution they recommended.</p>
        <p>I started {site.domain} to change that. I work independently, on my own, always in your interest. One senior advisor. No juniors on your project. No noise.</p>
        <p>That also means I can't do everything. Large implementation programs, teams of ten developers, global rollouts: that's not what I'm the right partner for, and I'll say so.</p>
      </div>
      <div>
        <p class="eyebrow">Experience at a glance</p>
        <div class="timeline">
          {timeline.map(([value, label]) => (
            <div><span class="icon-dot" aria-hidden="true">✓</span><p><b>{value}</b><br/>{label}</p></div>
          ))}
        </div>
      </div>
      <div>
        <p class="eyebrow">What I believe</p>
        {principlesEn.map(([title, text]) => (
          <div class="belief"><span class="icon-dot" aria-hidden="true">✓</span><div><b>{title}</b><p>{text}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm career">
    <div class="container career-grid">
      <div>
        <p class="eyebrow">Background</p>
        <h2 class="h2">Where this<br/><span class="marker">experience</span><br/>comes from.</h2>
      </div>
      <div class="career-list">
        {career.map(([period, role, text]) => (
          <div class="career-row">
            <span class="period">{period}</span>
            <div><b>{role}</b><p>{text}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm personal">
    <div class="container personal-grid">
      <div class="card personal-card">
        <p class="eyebrow">How I work in practice</p>
        <ul class="checks">
          <li>I'll tell you when I think you don't need me.</li>
          <li>I write everything myself. Whatever you get from me, I made it and can defend it.</li>
          <li>I work on a maximum of three engagements at a time, so attention never becomes scarce.</li>
          <li>I never take on two direct competitors at the same time.</li>
          <li>After three months I come back to check the promised result is actually there.</li>
        </ul>
      </div>
      <div class="card personal-card alt">
        <p class="eyebrow">Outside of work</p>
        <p>I read a lot about decision-making and risk, fields AI has surprisingly little to learn from. Beyond that: running, cooking, and the occasional DIY project gone wrong.</p>
        <p>I also speak: about AI decision-making, governance, and why most pilots stall. I'd rather have a sharp conversation with twenty people than give a keynote to five hundred.</p>
        <a class="text-link" href={contactHref}>Ask about availability →</a>
      </div>
    </div>
  </section>

  <section class="section-sm contact-teaser">
    <div class="container teaser-box dark-band">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 class="h2">Let's <span class="underline">get acquainted.</span></h2>
        <p>{availabilityEn}</p>
      </div>
      <div class="teaser-links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.linkedin} rel="noopener">LinkedIn ↗</a>
        {contactLive && <a class="btn" href={contactHref}>Go to the contact form →</a>}
      </div>
    </div>
  </section>

  <CTA locale="en" title="Book a no-obligation call." body="30 minutes. Online. No pitch deck. Just value." />
</BaseLayout>
<style>
.story{background:var(--cream-2)}
.story-grid{display:grid;grid-template-columns:1.15fr .85fr .85fr;gap:40px}
.story p{font-size:.94rem}
.timeline>div,.belief{display:grid;grid-template-columns:auto 1fr;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line)}
.timeline p,.belief p{margin:0;font-size:.82rem}
.belief b{color:var(--burgundy)}
.career-grid{display:grid;grid-template-columns:.5fr 1.5fr;gap:44px;align-items:start}
.career-row{display:grid;grid-template-columns:auto 1fr;gap:24px;padding:22px 0;border-bottom:1px solid var(--line)}
.career-row .period{font-family:'Caveat',cursive;font-weight:700;color:var(--salmon);font-size:1.2rem;min-width:88px}
.career-row b{color:var(--burgundy);font-size:1.08rem}
.career-row p{margin:6px 0 0;font-size:.88rem}
.personal-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.personal-card{padding:32px;box-shadow:none}
.personal-card.alt{background:var(--sand)}
.personal-card p{font-size:.9rem}
.teaser-box{display:grid;grid-template-columns:1.2fr .8fr;gap:40px;padding:44px;border-radius:22px;align-items:center}
.teaser-box .eyebrow{color:var(--salmon)}
.teaser-box p{color:#f0ded9;margin-bottom:0}
.teaser-links{display:flex;flex-direction:column;gap:12px;align-items:flex-start}
.teaser-links a{color:#f5e8df;font-size:.92rem}
.teaser-links .btn{color:var(--burgundy-deep);margin-top:10px}
@media(max-width:1000px){.story-grid{grid-template-columns:1fr 1fr}.story-grid>div:first-child{grid-column:1/-1}}
@media(max-width:820px){.story-grid,.career-grid,.personal-grid,.teaser-box{grid-template-columns:1fr}.teaser-box{padding:28px}}
</style>
