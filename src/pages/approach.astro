---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Steps from '../components/Steps.astro';
import CTA from '../components/CTA.astro';
import { stepDetailsEn, expectationsEn, antiPatternsEn, engagementModelsEn } from '../data/process.js';
import { procurementEn } from '../data/faq.js';
import { independenceEn } from '../data/site.js';
import { routeById } from '../data/routes';

const faqEntry = routeById('veelgestelde-vragen');
const faqLive = Boolean(faqEntry?.live.en);
const faqHref = faqLive ? faqEntry!.paths.en : null;
---
<BaseLayout
  title="AI Consulting Process | Freelance AI Consultant"
  description="Four decision points from diagnosis to governance. What to expect from me, what I don't do, and how engagement models and pricing work."
>
  <PageHero
    locale="en"
    compact
    eyebrow="No complex models. Just clear steps."
    title="How I work."
    marked="work"
    body="Independent advice, sharp priorities and decisions a board or leadership team can act on. From first question to working solution: practical, transparent and measurable."
    secondary="See the services"
    secondaryHref="/services"
  />

  <section class="section-sm">
    <div class="container">
      <p class="eyebrow">How I work</p>
      <h2 class="h2">My <span class="marker">4-step</span> approach.</h2>
      <div style="margin-top:28px"><Steps locale="en" /></div>
    </div>
  </section>

  <section class="section-sm detail">
    <div class="container">
      <p class="eyebrow">Each step explained</p>
      <div class="detail-list">
        {stepDetailsEn.map((step) => (
          <div class="detail-row">
            <div class="detail-head">
              <span class="step-num">{step.number}</span>
              <div>
                <h3>{step.title}</h3>
                <p class="lead">{step.lead}</p>
              </div>
            </div>
            <div class="detail-body">
              <p>{step.body}</p>
              <div class="detail-cols">
                <div>
                  <b>What we do</b>
                  <ul class="checks">{step.doing.map((line) => <li>{line}</li>)}</ul>
                </div>
                <div class="output">
                  <b>What it delivers</b>
                  <p>{step.output}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section approach">
    <div class="container triple">
      <div>
        <p class="eyebrow">What you can expect from me</p>
        <ul class="checks">{expectationsEn.map((line) => <li>{line}</li>)}</ul>
      </div>
      <div>
        <p class="eyebrow">What I don't do</p>
        <ul class="crosses">{antiPatternsEn.map((line) => <li>{line}</li>)}</ul>
      </div>
      <div class="models">
        <p class="eyebrow">Investment & models</p>
        {engagementModelsEn.map(([title, text]) => <div><b>{title}</b><span>{text}</span></div>)}
        <p class="hand">We agree on a model together →</p>
      </div>
    </div>
  </section>

  <section class="section-sm independence">
    <div class="container independence-card dark-band">
      <div>
        <p class="eyebrow">Independence, made concrete</p>
        <h2 class="h2">Why I can advise "don't buy."</h2>
        <p>Independence is easy to claim and hard to verify. That's why it's listed below as a commitment, not a promise, and why it's also in the engagement confirmation.</p>
      </div>
      <ul class="commit">{independenceEn.map((line) => <li>{line}</li>)}</ul>
    </div>
  </section>

  <section class="section-sm procurement">
    <div class="container">
      <p class="eyebrow">Procurement</p>
      <h2 class="h2">Frequently asked questions from procurement.</h2>
      <div class="grid-4 procure-grid">
        {procurementEn.map(([icon, title, text]) => (
          <div><span class="icon-dot" aria-hidden="true">{icon}</span><h3>{title}</h3><p>{text}</p></div>
        ))}
      </div>
      {faqHref && <p class="procure-more"><a class="text-link" href={faqHref}>All frequently asked questions about working together, pricing and data →</a></p>}
    </div>
  </section>

  <CTA locale="en" title="Ready for clear AI decisions?" />
</BaseLayout>
<style>
.detail{background:var(--cream-2)}
.detail-list{display:flex;flex-direction:column;gap:20px;margin-top:26px}
.detail-row{background:rgba(255,250,241,.62);border:1px solid var(--line);border-radius:16px;padding:28px}
.detail-head{display:grid;grid-template-columns:auto 1fr;gap:18px;align-items:center;margin-bottom:18px}
.detail-head .step-num{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:var(--burgundy);color:#fff;font-weight:800;font-size:.84rem}
.detail-head h3{margin:0;color:var(--burgundy);font-size:1.45rem;letter-spacing:-.03em}
.detail-head .lead{margin:4px 0 0;font-family:'Caveat',cursive;font-size:1.2rem;color:var(--salmon)}
.detail-body>p{margin-top:0;max-width:880px}
.detail-cols{display:grid;grid-template-columns:1.3fr .7fr;gap:30px;margin-top:20px}
.detail-cols b{display:block;color:var(--burgundy);font-size:.78rem;text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px}
.output{background:var(--aqua);padding:22px;border-radius:12px}
.output p{margin:0;font-size:.88rem}
.approach{background:var(--cream)}
.triple{display:grid;grid-template-columns:1fr 1fr 1fr;gap:24px}
.triple>div{padding:28px;background:rgba(255,250,241,.55);border:1px solid var(--line);border-radius:14px}
.models{background:var(--aqua)!important}
.models>div{padding:12px 0;border-bottom:1px solid rgba(74,31,42,.22)}
.models b,.models span{display:block}
.models span{font-size:.78rem;margin-top:3px}
.models .hand{font-size:1.25rem;margin:16px 0 0}
.independence-card{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;padding:44px;border-radius:22px;align-items:center}
.independence-card .eyebrow{color:var(--salmon)}
.independence-card p{color:#f0ded9;max-width:520px}
.commit{list-style:none;margin:0;padding:0}
.commit li{padding:12px 0;border-bottom:1px solid rgba(255,255,255,.18);font-weight:600;font-size:.92rem}
.commit li::before{content:'✓';display:inline-grid;place-items:center;width:22px;height:22px;border-radius:50%;background:var(--mustard);color:var(--burgundy-deep);margin-right:11px;font-size:.68rem}
.procure-grid>div{padding:16px}
.procure-grid h3{color:var(--burgundy);font-size:1rem;margin:12px 0 5px}
.procure-grid p{font-size:.8rem;margin:0}
.procure-more{margin-top:30px}
@media(max-width:900px){.triple,.detail-cols,.independence-card{grid-template-columns:1fr}.independence-card{padding:28px}}
</style>
