---
import BaseLayout from '../layouts/BaseLayout.astro';
import { featuredServices } from '../data/services.js';
import { articles } from '../data/articles/index.js';
const popular = articles.slice(0, 3);
---
<BaseLayout title="Pagina niet gevonden | Freelance AI Consultant" description="Deze pagina bestaat niet of is verplaatst. Bekijk de diensten, cases en artikelen van Dave Willemstein, onafhankelijk AI-adviseur." noindex={true}>
  <section class="section notfound">
    <div class="container nf-grid">
      <div>
        <p class="eyebrow">Foutje</p>
        <h1 class="h1">Deze pagina<br/><span class="marker">bestaat niet.</span></h1>
        <p class="lede">Verkeerde link, verouderde bookmark of een typefout. Hieronder staan de plekken waar de meeste mensen naartoe wilden.</p>
        <div class="actions"><a class="btn" href="/">Naar de homepage →</a><a class="text-link" href="/contact">Of stel je vraag direct →</a></div>
      </div>
      <div class="nf-links">
        <div class="card block">
          <p class="eyebrow">Diensten</p>
          {featuredServices.map((s) => <a href={`/diensten/${s.slug}`}>{s.title} →</a>)}
        </div>
        <div class="card block">
          <p class="eyebrow">Gelezen artikelen</p>
          {popular.map((a) => <a href={`/inzichten/${a.slug}`}>{a.title} →</a>)}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
.notfound{padding-top:60px}
.nf-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:54px;align-items:start}
.actions{display:flex;gap:24px;align-items:center;flex-wrap:wrap;margin-top:30px}
.nf-links{display:grid;gap:18px}
.block{padding:26px;box-shadow:none;display:flex;flex-direction:column;gap:12px}
.block a{font-weight:700;color:var(--burgundy);font-size:.92rem}
.block a:hover{color:var(--salmon)}
@media(max-width:850px){.nf-grid{grid-template-columns:1fr}}
</style>
