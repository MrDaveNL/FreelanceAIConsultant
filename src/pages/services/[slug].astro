---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Steps from '@/components/Steps.astro';
import Accordion from '@/components/Accordion.astro';
import CTA from '@/components/CTA.astro';
import RagBlok from '@/components/RagBlok.astro';
import { getCase } from '@/data/cases.js';
import { site } from '@/data/site.js';
import { routeById } from '@/data/routes';

export async function getStaticPaths() {
  const entries = await getCollection('services', ({ data }) => data.lang === 'en');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { service: entry.data } }));
}

const { service } = Astro.props;
const allEn = (await getCollection('services', ({ data }) => data.lang === 'en')).map((s) => s.data);
const related = (service.related ?? []).map((slug) => allEn.find((s) => s.slug === slug)).filter(Boolean);
const caseRoute = service.proof.caseSlug ? routeById(`case-${service.proof.caseSlug}`) : null;
const proofCaseHref = caseRoute?.live.en ? caseRoute.paths.en : null;
const approachHref = routeById('werkwijze')?.live.en ? routeById('werkwijze')?.paths.en : null;
const faqHref = routeById('veelgestelde-vragen')?.live.en ? routeById('veelgestelde-vragen')?.paths.en : null;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.lede,
  provider: { '@type': 'Person', name: site.name, url: site.url },
  areaServed: ['NL', 'BE', 'DE'],
  serviceType: 'AI advisory',
  offers: {
    '@type': 'Offer',
    priceCurrency: 'EUR',
    description: `${service.price}. ${service.priceNote}`,
  },
};
---
<BaseLayout
  title={`${service.title} | ${site.brand} Services`}
  description={service.meta ?? service.lede}
  schema={schema}
>
  <PageHero
    locale="en"
    compact
    eyebrow={service.eyebrow}
    title={service.heroTitle}
    marked={service.marked}
    body={service.lede}
    secondary="All services"
    secondaryHref="/services"
  />

  <section class="facts section-sm">
    <div class="container fact-grid">
      {service.facts.map((fact) => (
        <div class:list={['fact', `tone-${fact.tone}`]}><b>{fact.label}</b><strong>{fact.value}</strong></div>
      ))}
    </div>
    <div class="container"><p class="price-note">{service.priceNote} Amounts exclude VAT and travel expenses.</p></div>
  </section>

  <RagBlok pagina={`/services/${service.slug}`} />

  <section class="section-sm problem">
    <div class="container problem-grid">
      <div>
        <p class="eyebrow">Why this comes up</p>
        <h2 class="h2">{service.problemTitle}</h2>
      </div>
      <ul class="crosses">{service.problem.map((line) => <li>{line}</li>)}</ul>
    </div>
  </section>

  <section class="section-sm approach-section">
    <div class="container">
      <p class="eyebrow">How it works</p>
      <h2 class="h2">{service.approachIntro}</h2>
      <div class="approach-grid">
        {service.approach.map(([label, text], i) => (
          <div class="approach-step">
            <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{label}</h3>
            <p>{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section deliverables">
    <div class="container grid-2">
      <div>
        <p class="eyebrow">What you get</p>
        <h2 class="h2">Concrete. Clear.<br/>Immediately usable.</h2>
        <ul class="checks deliverable-list">{service.deliverables.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div class="best card">
        <p class="eyebrow">Best fit for</p>
        <h3 class="h3">Organizations that:</h3>
        <ul>{service.bestFor.map((item) => <li>{item}</li>)}</ul>
        <p class="eyebrow not">Less suitable if</p>
        <ul class="not-list">{service.notFor.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <p class="eyebrow">The rhythm underneath</p>
      <div class="split">
        <div><h2 class="h2">From insight<br/>to impact.</h2><p>Every engagement runs through the same four decision points. Only the depth per step differs.</p>{approachHref && <a class="text-link" href={approachHref}>More on my approach →</a>}</div>
        <Steps compact={true} locale="en" />
      </div>
    </div>
  </section>

  <section class="section-sm case-proof">
    <div class="container case-box">
      <div>
        <p class="eyebrow">{service.proof.eyebrow}</p>
        <h2 class="h2">{service.proof.title}</h2>
        {proofCaseHref && <a class="text-link" href={proofCaseHref}>Read the full case →</a>}
      </div>
      <p>{service.proof.body}</p>
      <div class="proofs">
        {service.proof.stats.map(([value, label]) => <b>{value}<span>{label}</span></b>)}
      </div>
    </div>
  </section>

  <section class="section-sm faq">
    <div class="container">
      <p class="eyebrow">Frequently asked questions</p>
      <h2 class="h2">Answers to what you are thinking now.</h2>
      <Accordion items={service.faq} name={`faq-${service.slug}`} />
      {faqHref && <p class="faq-more">More questions about working together, rates or procurement? <a class="text-link" href={faqHref}>See all frequently asked questions →</a></p>}
    </div>
  </section>

  {related.length > 0 && (
    <section class="section-sm related">
      <div class="container">
        <p class="eyebrow">Also relevant</p>
        <div class="grid-2">
          {related.map((item) => (
            <a class="related-card card" href={`/services/${item.slug}`}>
              <span class="icon-dot" aria-hidden="true">{item.icon}</span>
              <div><h3>{item.title}</h3><p>{item.cardText}</p><small>{item.timing} · {item.price}</small></div>
              <span aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTA locale="en" title="Book a call." body="30 minutes. No pitch deck. Just a good conversation about your situation." />
</BaseLayout>
<style>
/* min-width:0 op elk grid-item: zonder dit weigert een item te krimpen onder de min-content-breedte
   van zijn inhoud (lange tekst, tabel), wat de pagina horizontaal kan laten scrollen. */
.fact-grid,.problem-grid,.approach-grid,.split,.case-box,.proofs,.related-card{min-width:0}
.fact-grid>*,.problem-grid>*,.approach-grid>*,.split>*,.case-box>*,.proofs>*,.related-card>*{min-width:0}
.fact-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;max-width:820px}
.fact{padding:18px 22px;border-radius:10px;display:flex;flex-direction:column}
.fact b{text-transform:uppercase;font-size:.72rem}
.fact strong{font-size:1.3rem;color:var(--burgundy);line-height:1.1;margin-top:4px}
.tone-aqua{background:var(--aqua)}.tone-salmon{background:var(--salmon)}.tone-yellow{background:var(--mustard)}.tone-sand{background:var(--sand)}
.price-note{margin-top:16px;font-size:.78rem;color:var(--muted);max-width:820px}
.problem{background:var(--cream-2)}
.problem-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:44px;align-items:start}
.approach-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:32px}
.approach-step{padding:24px;border:1px solid var(--line);border-radius:14px;background:rgba(255,250,241,.6)}
.approach-step .step-num{display:inline-grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--burgundy);color:#fff;font-size:.72rem;font-weight:800}
.approach-step h3{color:var(--burgundy);font-size:1.12rem;margin:16px 0 8px}
.approach-step p{font-size:.84rem;margin:0}
.deliverables{background:var(--cream-2)}
.deliverable-list{margin-top:28px}
.best{padding:32px;box-shadow:none;background:var(--paper)}
.best ul{padding-left:19px;margin:10px 0 0}
.best li{margin:12px 0;font-size:.9rem}
.best .not{margin-top:28px}
.not-list li{color:var(--muted)}
.split{display:grid;grid-template-columns:.45fr 1.55fr;gap:40px;align-items:start;margin-top:22px}
.split p{margin:18px 0}
.case-box{display:grid;grid-template-columns:.8fr 1.2fr;gap:34px;align-items:start}
.proofs{grid-column:2;display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.proofs b{font-size:1.7rem;color:var(--burgundy);padding-right:12px;border-right:1px solid var(--line)}
.proofs span{display:block;font-size:.67rem;color:var(--muted);font-weight:500;line-height:1.15;margin-top:4px}
.faq-more{margin-top:26px;font-size:.86rem;color:var(--muted)}
.related{background:var(--cream-2)}
.related-card{padding:24px;display:grid;grid-template-columns:auto 1fr auto;gap:16px;align-items:center;box-shadow:none;transition:transform .2s ease}
.related-card:hover{transform:translateY(-3px)}
.related-card h3{margin:0;color:var(--burgundy);font-size:1.15rem}
.related-card p{margin:6px 0 0;font-size:.82rem}
.related-card small{display:block;margin-top:8px;font-size:.72rem;font-weight:700;color:var(--muted)}
@media(max-width:1000px){.approach-grid{grid-template-columns:1fr 1fr}}
@media(max-width:900px){.problem-grid,.split,.case-box{grid-template-columns:1fr}.proofs{grid-column:1;grid-template-columns:1fr 1fr}.fact-grid{grid-template-columns:1fr}}
@media(max-width:620px){.approach-grid{grid-template-columns:1fr}}
</style>
