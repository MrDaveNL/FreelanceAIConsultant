---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import MetricStrip from '../components/MetricStrip.astro';
import Comparison from '../components/Comparison.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Steps from '../components/Steps.astro';
import CaseCard from '../components/CaseCard.astro';
import CTA from '../components/CTA.astro';
import { site, metricsEn, independenceEn } from '../data/site.js';
import { testimonialsEn } from '../data/cases.js';
import { routeById } from '../data/routes';

const casesLive = Boolean(routeById('cases')?.live.en);
const servicesLive = Boolean(routeById('diensten')?.live.en);
const approachLive = Boolean(routeById('werkwijze')?.live.en);
const insightsLive = Boolean(routeById('inzichten')?.live.en);
const approachHref = routeById('werkwijze')?.paths.en ?? '/approach';
const casesHref = routeById('cases')?.paths.en ?? '/cases';
const servicesHref = routeById('diensten')?.paths.en ?? '/services';
const insightsHref = routeById('inzichten')?.paths.en ?? '/insights';

let featuredServices = [];
if (servicesLive) {
  const entries = await getCollection('services', ({ data }) => data.lang === 'en' && data.featured);
  featuredServices = entries.map((s) => s.data);
}

let homeCases = [];
if (casesLive) {
  const entries = await getCollection('cases', ({ data }) => data.lang === 'en');
  homeCases = entries.map((c) => c.data).slice(0, 3);
}

let homeArticles = [];
if (insightsLive) {
  const entries = await getCollection('articles', ({ data }) => data.lang === 'en');
  homeArticles = entries
    .map((a) => a.data)
    .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
    .slice(0, 4);
}

const description = `Freelance AI consultant helping CIOs, CDOs and AI leads decide where AI creates real value, which vendors fit, and how pilots turn into results.`;
---
<BaseLayout title="Freelance AI Consultant | From AI Strategy to Results" description={description}>
  <PageHero
    locale="en"
    eyebrow="AI decisions that hold up"
    title="Make the AI decisions you have to defend to your board."
    marked="AI decisions"
    body="I help CIOs, CDOs and AI leads decide where AI actually creates value, which vendors fit, and how to stop pilots turning into expensive side projects."
    secondary={casesLive ? 'See client work' : undefined}
    secondaryHref={casesHref}
  />

  <MetricStrip items={metricsEn} />

  <Comparison locale="en" />

  {servicesLive && featuredServices.length > 0 && (
    <section class="section services">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">How I help</p>
            <h2 class="h2">Three ways to <span class="marker">move forward.</span></h2>
          </div>
          <a class="text-link" href={servicesHref}>All services →</a>
        </div>
        <div class="service-grid">
          {featuredServices.map((service) => <ServiceCard service={service} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section-sm how">
    <div class="container how-grid">
      <div>
        <p class="eyebrow">How I work</p>
        <h2 class="h2">No 200-slide deck.</h2>
        <p class="lede">Just four clear <span class="marker">decision points.</span></p>
        {approachLive && <a class="text-link" href={approachHref}>See my approach →</a>}
      </div>
      <Steps compact={true} locale="en" />
    </div>
  </section>

  {casesLive && homeCases.length > 0 && (
    <section class="section cases-preview">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">Recent work</p>
            <h2 class="h2">Work that <span class="marker">makes the difference.</span></h2>
          </div>
          <a class="text-link" href={casesHref}>All cases →</a>
        </div>
        <div class="grid-3">
          {homeCases.map((item) => <CaseCard item={item} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section-sm quotes-band">
    <div class="container">
      <p class="eyebrow">What clients say</p>
      <div class="grid-3 quotes">
        {testimonialsEn.map((quote) => (
          <blockquote>&ldquo;{quote.text}&rdquo;<cite>{quote.author}{quote.translated && ' (Translated from Dutch)'}</cite></blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="section ethics">
    <div class="container ethics-card">
      <div>
        <p class="eyebrow">My independence commitment</p>
        <h2 class="h2">I don't earn more when you buy more software.</h2>
        <p>My income comes entirely from the advisory hours you pay for. No vendor pays me anything, in any form. That is why I can advise "no, don't buy this" without it costing me money.</p>
        <p>When a project needs more hands than I have, I introduce vetted partners for execution, for development, data or training. You contract them directly. I take no margin and no commission on their work.</p>
      </div>
      <ul>{independenceEn.map((item) => <li>{item}</li>)}</ul>
      {approachLive && <a class="btn btn--ghost" href={approachHref}>See my approach →</a>}
    </div>
  </section>

  {insightsLive && homeArticles.length > 0 && (
    <section class="section-sm insights-preview">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">Insights</p>
            <h2 class="h2">Read before you <span class="marker">decide.</span></h2>
          </div>
          <a class="text-link" href={insightsHref}>All insights →</a>
        </div>
        <div class="grid-4">
          {homeArticles.map((item) => <ArticleCard item={item} />)}
        </div>
      </div>
    </section>
  )}

  <CTA locale="en" />
</BaseLayout>
<style>
.service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.how{background:var(--cream-2)}
.how-grid{display:grid;grid-template-columns:minmax(280px,.58fr) 1.42fr;gap:44px;align-items:center}
.how-grid .text-link{display:inline-block;margin-top:8px}
.quotes-band{background:var(--cream-2)}
blockquote{margin:0;font-family:'Caveat',cursive;font-size:1.5rem;line-height:1.1;color:var(--burgundy);padding:22px 26px;border-left:4px solid var(--salmon)}
cite{display:block;font-family:'Space Grotesk',sans-serif;font-style:normal;font-size:.74rem;color:var(--muted);margin-top:16px}
.ethics-card{display:grid;grid-template-columns:1.2fr .8fr;gap:34px;background:rgba(255,250,241,.7);border:1px solid var(--line);padding:44px;border-radius:22px}
.ethics-card p{max-width:520px}
.ethics-card ul{margin:0;padding:0;list-style:none}
.ethics-card li{padding:11px 0;border-bottom:1px solid var(--line);font-weight:600}
.ethics-card li::before{content:'✓';display:inline-grid;place-items:center;width:23px;height:23px;border-radius:50%;background:var(--burgundy);color:white;margin-right:10px;font-size:.72rem}
.ethics-card .btn{grid-column:1/-1;width:max-content}
@media(max-width:900px){.service-grid{grid-template-columns:1fr}.how-grid{grid-template-columns:1fr}.ethics-card{grid-template-columns:1fr;padding:28px}}
</style>
