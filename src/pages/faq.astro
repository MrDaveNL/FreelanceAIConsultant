---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Accordion from '../components/Accordion.astro';
import CTA from '../components/CTA.astro';
import { faqGroupsEn } from '../data/faq.js';
import { site } from '../data/site.js';
import { routeById } from '../data/routes';

const allItems = faqGroupsEn.flatMap((group) => group.items);

const contactEntry = routeById('contact');
const contactHref = contactEntry?.live.en ? contactEntry.paths.en : `mailto:${site.email}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allItems.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---
<BaseLayout
  title={`AI Consultant FAQ | ${site.brand}`}
  description="Answers about working together, independence, approach, pricing, procurement and data security. Everything you would normally ask in a first conversation."
  schema={schema}
>
  <PageHero
    locale="en"
    compact
    eyebrow="Everything you want to know"
    title="Frequently asked questions."
    marked="questions"
    body={`${allItems.length} questions about working together, independence, approach, pricing and procurement. Don't see your question? Just ask it. You'll get an answer within one business day.`}
    secondary="View services"
    secondaryHref="/services"
  />

  <section class="section-sm">
    <div class="container jump">
      {faqGroupsEn.map((group) => (
        <a class="jump-link" href={`#${group.title.toLowerCase().replace(/[^a-z]+/g, '-')}`}>
          <span class="icon-dot" aria-hidden="true">{group.icon}</span>
          <span>{group.title}</span>
          <small>{group.items.length} questions</small>
        </a>
      ))}
    </div>
  </section>

  {faqGroupsEn.map((group, i) => (
    <section class:list={['section-sm faq-group', i % 2 === 1 && 'alt']} id={group.title.toLowerCase().replace(/[^a-z]+/g, '-')}>
      <div class="container group-grid">
        <div>
          <span class="icon-dot big" aria-hidden="true">{group.icon}</span>
          <h2 class="h2">{group.title}</h2>
        </div>
        <Accordion items={group.items} name={`faq-${i}`} />
      </div>
    </section>
  ))}

  <section class="section-sm rest">
    <div class="container rest-box card">
      <div>
        <p class="eyebrow">Don't see your question?</p>
        <h2 class="h3">Just ask it. Even if you're not sure yet whether you need something.</h2>
      </div>
      <a class="btn" href={contactHref}>Ask your question →</a>
    </div>
  </section>

  <CTA locale="en" />
</BaseLayout>
<style>
.jump{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}
.jump-link{display:flex;flex-direction:column;gap:10px;padding:20px;border:1px solid var(--line);border-radius:14px;background:rgba(255,250,241,.6);transition:transform .2s ease,background .2s}
.jump-link:hover{transform:translateY(-3px);background:rgba(255,250,241,.95)}
.jump-link span:nth-child(2){font-weight:800;color:var(--burgundy);font-size:.92rem}
.jump-link small{font-size:.74rem;color:var(--muted)}
.faq-group.alt{background:var(--cream-2)}
.group-grid{display:grid;grid-template-columns:.42fr 1.58fr;gap:48px;align-items:start}
.icon-dot.big{width:56px;height:56px;font-size:1.3rem;margin-bottom:18px}
.rest-box{display:grid;grid-template-columns:1fr auto;gap:30px;align-items:center;padding:34px;box-shadow:none;background:var(--mustard);border-color:rgba(74,31,42,.12)}
.rest-box h2{margin:0;max-width:640px}
@media(max-width:1000px){.jump{grid-template-columns:1fr 1fr}}
@media(max-width:820px){.group-grid,.rest-box{grid-template-columns:1fr}}
</style>
