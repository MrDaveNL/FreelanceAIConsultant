---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroPortrait from '@/components/HeroPortrait.astro';
import CTA from '@/components/CTA.astro';
import { site, seoTitle } from '@/data/site.js';

export async function getStaticPaths() {
  const entries = await getCollection('cases', ({ data }) => data.lang === 'en');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { item: entry.data } }));
}

const { item } = Astro.props;
const allEnCases = (await getCollection('cases', ({ data }) => data.lang === 'en')).map((c) => c.data);
const allEnServices = (await getCollection('services', ({ data }) => data.lang === 'en')).map((s) => s.data);
const service = allEnServices.find((s) => s.slug === item.serviceSlug);
const next = allEnCases.find((c) => c.slug === item.next);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: item.cardTitle,
  description: item.lede,
  author: { '@type': 'Person', name: site.name, url: site.url },
  publisher: { '@type': 'Person', name: site.name },
  about: item.sector,
};
---
<BaseLayout
  title={seoTitle(item.metaTitle ?? `Case: ${item.cardTitle}`)}
  description={item.metaDescription ?? item.lede}
  schema={schema}
>
  <article>
    <section class="case-hero section-sm">
      <div class="container case-hero-grid">
        <div>
          <a class="back" href="/cases">← Back to case studies</a>
          <p class="eyebrow">{item.sector}</p>
          <h1 class="h1"><span class="marker">{item.titleMarked}</span><br/>{item.titleRest}</h1>
          <p class="lede">{item.lede}</p>
          <div class="tags">
            <span>Sector: {item.sector}</span>
            <span>Service: {item.service}</span>
            <span>Duration: {item.duration}</span>
            <span>Year: {item.year}</span>
          </div>
        </div>
        <div class="proof-panel">
          <p class="eyebrow">Proof in numbers</p>
          {item.proof.map(([value, label]) => (
            <div class="proof"><span class="icon-dot" aria-hidden="true">✓</span><b>{value}</b><small>{label}</small></div>
          ))}
        </div>
      </div>
    </section>

    <section class="section-sm">
      <div class="container visual-case">
        <div class="portrait"><HeroPortrait compact={true} /></div>
        <div class="sticker sticker--yellow">Focused on value</div>
        <div class="sticker sticker--salmon">No hype<br/>real impact</div>
      </div>
    </section>

    <section class="section-sm">
      <div class="container story-grid">
        <div class="story">
          {item.story.map(([title, body], i) => (
            <div class="story-row">
              <span class="icon-dot" aria-hidden="true">{i + 1}</span>
              <div><p class="eyebrow">{title}</p><p>{body}</p></div>
            </div>
          ))}
        </div>
        <aside>
          <div class="quote-card">&ldquo;{item.quote.text}&rdquo;<small>{item.quote.author}{item.quote.translated && ' (Translated from Dutch)'}</small></div>
          <div class="role card">
            <p class="eyebrow">My role</p>
            <ul>{item.role.map((line) => <li>{line}</li>)}</ul>
          </div>
          {service && (
            <a class="service-link card" href={`/services/${service.slug}`}>
              <p class="eyebrow">Service used</p>
              <b>{service.title}</b>
              <small>{service.timing}</small>
              <span>View this service →</span>
            </a>
          )}
        </aside>
      </div>
    </section>

    {next && (
      <section class="section-sm next-case">
        <div class="container next-box">
          <div><p class="eyebrow">Next case</p><h2 class="h2">{next.cardTitle}</h2><p>{next.challenge}</p></div>
          <a class="btn" href={`/cases/${next.slug}`}>Read the case →</a>
        </div>
      </section>
    )}

    <CTA locale="en" title="Let's discuss your case." body="A no-obligation conversation about your challenge, the options, and the best next step." />
  </article>
</BaseLayout>
<style>
/* min-width:0 op elk grid-item: zonder dit weigert een item te krimpen onder de min-content-breedte
   van zijn inhoud (lange tekst, tabel), wat de pagina horizontaal kan laten scrollen. */
.case-hero-grid>*,.proof>*,.story-grid>*,.story-row>*,.next-box>*{min-width:0}
.case-hero{padding-top:54px}
.case-hero-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:60px}
.tags{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}
.tags span{padding:8px 12px;background:rgba(255,250,241,.66);border:1px solid var(--line);border-radius:999px;font-size:.76rem}
.proof-panel{padding-top:55px}
.proof{display:grid;grid-template-columns:auto .55fr 1fr;gap:15px;align-items:center;padding:15px 0;border-bottom:1px solid var(--line)}
.proof b{font-size:1.65rem;color:var(--burgundy)}
.proof small{font-size:.76rem}
.visual-case{position:relative;min-height:420px;background:color-mix(in srgb,var(--sand) 32%,transparent);border-radius:18px;overflow:hidden}
.portrait{width:56%;margin:auto}
.visual-case>.sticker{position:absolute;right:12%;top:24%}
.visual-case>.sticker:last-child{top:43%;right:8%}
.story-grid{display:grid;grid-template-columns:1.4fr .6fr;gap:50px}
.story-row{display:grid;grid-template-columns:auto 1fr;gap:20px;padding:20px 0;border-bottom:1px solid var(--line)}
.story-row .eyebrow{margin:0}
.story-row p:last-child{margin:4px 0 0}
.quote-card{background:var(--aqua);border-radius:18px;padding:30px;font-family:'Caveat',cursive;font-size:1.42rem;line-height:1.14;color:var(--burgundy)}
.quote-card small{display:block;margin-top:18px;font-family:'Space Grotesk',sans-serif;font-size:.72rem}
.role{margin-top:22px;padding:26px;box-shadow:none}
.role ul{padding-left:18px;margin:0}
.role li{font-size:.86rem;margin:8px 0}
.service-link{display:block;margin-top:22px;padding:26px;box-shadow:none;background:var(--mustard);border-color:rgba(74,31,42,.12);transition:transform .2s ease}
.service-link:hover{transform:translateY(-3px)}
.service-link b{display:block;color:var(--burgundy);font-size:1.15rem}
.service-link small{display:block;margin-top:6px;font-size:.76rem}
.service-link span{display:block;margin-top:14px;font-weight:800;font-size:.8rem}
.next-case{background:var(--cream-2)}
.next-box{display:grid;grid-template-columns:1fr auto;gap:34px;align-items:center}
.next-box p:last-of-type{margin:12px 0 0;max-width:620px;font-size:.9rem}
@media(max-width:850px){.case-hero-grid,.story-grid,.next-box{grid-template-columns:1fr}.proof-panel{padding-top:0}.portrait{width:90%}}
</style>
