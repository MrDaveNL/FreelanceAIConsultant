---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CaseCard from '@/components/CaseCard.astro';
import FilterBar from '@/components/FilterBar.astro';
import CTA from '@/components/CTA.astro';
import { caseFiltersEn, testimonialsEn } from '@/data/cases.js';

const cases = (await getCollection('cases', ({ data }) => data.lang === 'en')).map((c) => c.data);
---
<BaseLayout
  title="AI Consulting Case Studies | Freelance AI Consultant"
  description="Six AI engagements, from strategy to vendor selection and fractional leadership. Real challenges, the choices made, and what they delivered."
>
  <PageHero
    locale="en"
    compact
    eyebrow="AI advice that helps you decide"
    title="Case studies that make the difference."
    marked="the difference"
    body="Real challenges. Sharp choices. Measurable results. Including the engagements where the advice was not to buy. Those often deliver the most."
    secondary="See the services"
    secondaryHref="/services"
  />

  <section class="section-sm">
    <div class="container">
      <FilterBar filters={caseFiltersEn} target="#case-grid" center={true} locale="en" />
    </div>
  </section>

  <section class="section-sm cases">
    <div class="container">
      <div class="grid-3" id="case-grid">
        {cases.map((item) => <CaseCard item={item} />)}
      </div>
    </div>
  </section>

  <section class="section-sm testimonials">
    <div class="container">
      <p class="eyebrow">What clients say</p>
      <div class="grid-3 quotes">
        {testimonialsEn.map((quote) => (
          <blockquote>&ldquo;{quote.text}&rdquo;<cite>{quote.author}{quote.translated && ' (Translated from Dutch)'}</cite></blockquote>
        ))}
      </div>
      <p class="disclosure">Clients are shown anonymized on request. Named references are shared in a personal conversation.</p>
    </div>
  </section>

  <CTA locale="en" title="Ready to make your case the next one?" />
</BaseLayout>
<style>
.testimonials{background:var(--cream-2)}
blockquote{margin:0;font-family:'Caveat',cursive;font-size:1.5rem;line-height:1.1;color:var(--burgundy);padding:22px 26px;border-left:4px solid var(--salmon)}
cite{display:block;font-family:'Space Grotesk',sans-serif;font-style:normal;font-size:.74rem;color:var(--muted);margin-top:16px}
.disclosure{margin-top:30px;font-size:.76rem;color:var(--muted)}
</style>
