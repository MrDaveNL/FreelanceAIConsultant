---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Accordion from '../components/Accordion.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site.js';
import { services } from '../data/services.js';
import { resolveToken, resolveContactHref } from '../lib/service-tokens.js';
import { protectedUrls } from '../data/protected-urls.js';
import { routeById } from '../data/routes';
import { t, localeFromPath, SCHEMA_LANG } from '../i18n';
import '../styles/content-pages.css';
import '../styles/rag-blok.css';

export async function getStaticPaths() {
  const entries = await getCollection('pages');
  const seen = new Set();
  for (const entry of entries) {
    const { url, id } = entry.data;
    if (protectedUrls.includes(url)) throw new Error(`${id} probeert bestaande URL ${url} te genereren.`);
    if (seen.has(url)) throw new Error(`Dubbele URL in content: ${url}`);
    seen.add(url);
  }
  return entries.map((entry) => ({
    params: { slug: entry.data.url.slice(1) },
    props: { entry, all: entries },
  }));
}

const { entry, all } = Astro.props;
const locale = localeFromPath(entry.data.url);
// Prijstokens ({{price:slug}} e.d.) ook buiten de Markdown-body vervangen (zie astro.config.mjs).
const tokenize = (text) => text.replace(/\{\{(price|pricelc|timing|title):([a-z0-9-]+)\}\}/g, (_, field, slug) => resolveToken(field, slug, locale));
const page = {
  ...entry.data,
  lede: tokenize(entry.data.lede),
  summary: entry.data.summary?.map(tokenize),
  faq: entry.data.faq?.map(({ q, a }) => ({ q: tokenize(q), a: tokenize(a) })),
  primaryCta: entry.data.primaryCta && { ...entry.data.primaryCta, href: resolveContactHref(entry.data.primaryCta.href, locale) },
  secondaryCta: entry.data.secondaryCta && { ...entry.data.secondaryCta, href: resolveContactHref(entry.data.secondaryCta.href, locale) },
};
const { Content } = await render(entry);
const byUrl = new Map(all.map((e) => [e.data.url, e.data]));
const pageUrl = `${site.url}${page.url}`;
const isArticle = page.schema === 'article' || page.schema === 'collection';
const dict = t(locale);
const homeHref = routeById('home')?.paths[locale] ?? '/';
const overEntry = routeById('over');
const overHref = overEntry?.live[locale] ? overEntry.paths[locale] : null;
const partnernetworkEntry = routeById('P06');
const partnernetworkHref = partnernetworkEntry?.live[locale] ? partnernetworkEntry.paths[locale] : null;
const serviceHref = (slug) => routeById(`svc-${slug}`)?.paths[locale] ?? `/diensten/${slug}`;

// Breadcrumbs volgen de URL-structuur.
const segments = page.url.replace(/^\/nl\//, '').split('/').filter(Boolean);
const urlPrefix = locale === 'nl' ? '/nl' : '';
const crumbs = [{ href: homeHref, label: dict.breadcrumbs.home }];
segments.slice(0, -1).forEach((_, i) => {
  const href = `${urlPrefix}/${segments.slice(0, i + 1).join('/')}`;
  const match = byUrl.get(href);
  if (match) crumbs.push({ href, label: match.navLabel });
});

const formatDate = (iso) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString(locale === 'nl' ? 'nl-NL' : 'en-US', { day: 'numeric', month: 'long', year: 'numeric' });

// Kennisbank-overzicht (P08): artikelen gegroepeerd per onderwerp.
const kbCategories = locale === 'en'
  ? [
      ['AI consulting and strategy', ['C1', 'C4']],
      ['AI implementation', ['C2', 'C5']],
      ['AI automation', ['C3']],
      ['AI agents', ['C6']],
      ['AI policy and the AI Act', ['C8']],
      ['AI tools', ['C10']],
    ]
  : [
      ['AI consultancy en strategie', ['C1', 'C4']],
      ['AI implementatie', ['C2', 'C5']],
      ['AI automatisering', ['C3']],
      ['AI agents', ['C6']],
      ['AI beleid en AI Act', ['C8']],
      ['AI tools', ['C10']],
    ];
const categoryOf = (p) => {
  if (p.id === 'C3-05') return 'AI tools';
  const prefix = p.id.split('-')[0];
  return kbCategories.find(([, prefixes]) => prefixes.includes(prefix))?.[0];
};
const articles = all
  .map((e) => e.data)
  .filter((p) => p.schema === 'article' && p.lang === locale && categoryOf(p))
  .sort((a, b) => (a.published < b.published ? 1 : a.published > b.published ? -1 : a.id.localeCompare(b.id)));
const featuredIds = ['C2-03', 'C6-01', 'C3-06'];
const featured = featuredIds.map((id) => articles.find((p) => p.id === id)).filter(Boolean);
const newest = [...articles].sort((a, b) => (a.updated < b.updated ? 1 : -1)).slice(0, 6);

// Structured data.
const person = { '@type': 'Person', name: site.name, jobTitle: site.roleNl, url: `${site.url}/over`, sameAs: [site.linkedin] };
const graph = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [...crumbs, { href: page.url, label: page.navLabel }].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      item: `${site.url}${c.href === '/' ? '/' : c.href}`,
    })),
  },
];
if (page.schema === 'service') {
  graph.push({ '@type': 'Service', name: page.navLabel, serviceType: page.keyphrase, description: page.metaDescription, url: pageUrl, areaServed: locale === 'en' ? 'GB' : 'NL', provider: person });
} else if (page.schema === 'pricing') {
  graph.push({
    '@type': 'Service',
    name: 'AI consultancy',
    description: page.metaDescription,
    url: pageUrl,
    provider: person,
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Pakketten',
      itemListElement: services.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s.title, url: `${site.url}${serviceHref(s.slug)}` },
      })),
    },
  });
} else if (page.schema === 'collection') {
  graph.push({
    '@type': 'CollectionPage',
    name: page.title,
    description: page.metaDescription,
    url: pageUrl,
    hasPart: articles.map((p) => ({ '@type': 'Article', headline: p.title, url: `${site.url}${p.url}` })),
  });
} else {
  graph.push({
    '@type': 'Article',
    headline: page.title,
    description: page.metaDescription,
    inLanguage: SCHEMA_LANG[locale],
    datePublished: page.published,
    dateModified: page.updated,
    author: person,
    publisher: { '@type': 'Person', name: site.name },
    mainEntityOfPage: pageUrl,
  });
}
if (page.faq?.length) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: page.faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  });
}
const schema = { '@context': 'https://schema.org', '@graph': graph };
---
<BaseLayout title={page.metaTitle} description={page.metaDescription} schema={schema} noindex={page.noindex ? 'noindex, follow' : false}>
  <article class="cp">
    <header class="cp-hero">
      <div class="container cp-hero-grid">
        <div>
          <nav class="crumbs" aria-label={dict.breadcrumbs.aria}>
            <ol>
              {crumbs.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
              <li aria-current="page">{page.navLabel}</li>
            </ol>
          </nav>
          <p class="eyebrow">{page.eyebrow}</p>
          <h1 class="cp-h1">{page.title}</h1>
          <p class="lede">{page.lede}</p>
          <div class="cp-actions">
            <a class="btn" href={page.primaryCta.href}>{page.primaryCta.label} →</a>
            {page.secondaryCta && <a class="text-link" href={page.secondaryCta.href}>{page.secondaryCta.label} →</a>}
          </div>
          {isArticle && (
            <p class="cp-meta">
              {dict.contentPage.writtenBy} <a href={overHref}>{site.name}</a>, {dict.contentPage.writtenByRole} ·
              {dict.contentPage.published} <time datetime={page.published}>{formatDate(page.published)}</time>
              {page.updated !== page.published && <> · {dict.contentPage.updated} <time datetime={page.updated}>{formatDate(page.updated)}</time></>}
            </p>
          )}
        </div>
        {page.summary?.length ? (
          <div class="sticky-note cp-note">
            <p class="hand">{dict.contentPage.inShort.toUpperCase()}</p>
            <ul>{page.summary.map((line) => <li>{line}</li>)}</ul>
          </div>
        ) : <div />}
      </div>
    </header>

    <section class="section-sm">
      <div class="container cp-grid">
        <div class="prose">
          <Content />

          {page.id === 'P08' && (
            <>
              <h2 id="uitgelicht">{dict.contentPage.kbFeatured}</h2>
              <div class="kb-grid">
                {featured.map((p) => (
                  <a class="kb-card card" href={p.url}><span class="kb-cat">{categoryOf(p)}</span><b>{p.title}</b><span>{p.metaDescription}</span></a>
                ))}
              </div>
              <h2 id="onderwerpen">{dict.contentPage.kbTopics}</h2>
              {kbCategories.map(([label]) => {
                const items = articles.filter((p) => categoryOf(p) === label);
                return items.length > 0 && (
                  <>
                    <h3>{label}</h3>
                    <ul class="kb-list">{items.map((p) => <li><a href={p.url}>{p.title}</a></li>)}</ul>
                  </>
                );
              })}
              <h2 id="nieuwste">{dict.contentPage.kbNewest}</h2>
              <ul class="kb-list">
                {newest.map((p) => <li><a href={p.url}>{p.title}</a> <span class="muted">· {formatDate(p.updated)}</span></li>)}
              </ul>
            </>
          )}
        </div>

        <aside class="cp-aside">
          <div class="expert card">
            <img src={site.portrait} alt={locale === 'en' ? `Portrait of ${site.name}` : `Portret van ${site.name}`} width="88" height="88" loading="lazy" decoding="async" />
            <div>
              <b>{site.name}</b>
              <span>{locale === 'en' ? site.role : site.roleNl}</span>
            </div>
            <p>{dict.contentPage.independence}</p>
            {overHref && <a class="text-link" href={overHref}>{dict.nav.over}</a>}
            {partnernetworkHref && page.url !== partnernetworkHref && <a class="text-link" href={partnernetworkHref}>{dict.contentPage.partnerNetworkLink}</a>}
          </div>
          <a class="aside-cta card" href={serviceHref('ai-readiness-assessment')}>
            <b>{dict.contentPage.asideCtaTitle}</b>
            <span>{dict.contentPage.asideCtaLink}</span>
          </a>
        </aside>
      </div>
    </section>

    {page.faq?.length > 0 && (
      <section class="section-sm cp-faq">
        <div class="container cp-narrow">
          <h2 class="h3">{page.faqTitle ?? 'Veelgestelde vragen'}</h2>
          <Accordion items={page.faq.map(({ q, a }) => [q, a])} name={`faq-${page.id}`} />
        </div>
      </section>
    )}

    {page.sources?.length > 0 && (
      <section class="section-sm cp-sources">
        <div class="container cp-narrow">
          <h2 class="h3">{dict.contentPage.sources}</h2>
          <ul>{page.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.title}</a></li>)}</ul>
        </div>
      </section>
    )}

    <CTA locale={locale} title={dict.contentPage.ctaDefaultTitle} />
  </article>
</BaseLayout>
