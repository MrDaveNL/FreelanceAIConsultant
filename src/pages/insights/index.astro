---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import FilterBar from '@/components/FilterBar.astro';
import NewsletterEn from '@/components/NewsletterEn.astro';
import { routeById } from '@/data/routes';

const articles = (await getCollection('articles', ({ data }) => data.lang === 'en'))
  .map((a) => a.data)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const featuredArticle = articles.find((a) => a.featured) ?? articles[0];
const articleCategories = ['All insights', ...Array.from(new Set(articles.map((a) => a.category)))];
const casesHref = routeById('cases')?.live.en ? routeById('cases')!.paths.en : '/cases';
---
<BaseLayout
  title="Insights | Freelance AI Consultant"
  description="Practical articles on AI strategy, use cases, governance, the data foundation and vendor selection. Written for senior leaders who need to decide."
>
  <PageHero
    locale="en"
    compact
    eyebrow="AI advice that helps you decide"
    title="Practical insights for better AI decisions."
    marked="insights"
    body={`Real-world experience, frameworks and no-nonsense advice for senior leaders who want to put AI to work with impact. ${articles.length} articles, none of them written to sell you anything.`}
    secondary="See my case studies"
    secondaryHref={casesHref}
  />

  {featuredArticle && (
    <section class="section-sm">
      <div class="container feature card">
        <div class="feature-art" aria-hidden="true">
          <span class="bubble salmon">Freelance AI consultant</span>
          <span class="bubble aqua">Agency</span>
          <span class="bubble yellow">Big 4</span>
        </div>
        <div>
          <p class="eyebrow">Featured article</p>
          <h2 class="h2">{featuredArticle.title}</h2>
          <p>{featuredArticle.excerpt}</p>
          <div class="feature-meta">◷ {featuredArticle.readingTime} <span>{featuredArticle.dateLabel}</span></div>
          <a class="text-link" href={`/insights/${featuredArticle.slug}`}>Read article →</a>
        </div>
      </div>
    </section>
  )}

  <section class="section-sm">
    <div class="container">
      <FilterBar filters={articleCategories} target="#article-grid" locale="en" />
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <div class="section-head"><h2 class="h3">All articles</h2><span class="count">{articles.length} articles · <a href="/rss.xml">RSS</a></span></div>
      <div class="grid-4 articles" id="article-grid">
        {articles.map((item) => <ArticleCard item={item} locale="en" />)}
      </div>
    </div>
  </section>

  <NewsletterEn />
</BaseLayout>
<style>
.feature{display:grid;grid-template-columns:.8fr 1.2fr;gap:36px;padding:20px;box-shadow:none;align-items:center}
.feature>div:last-child{padding:12px 20px 12px 0}
.feature-art{position:relative;min-height:330px;background:var(--aqua);border-radius:14px;overflow:hidden}
.bubble{position:absolute;width:158px;height:158px;border-radius:50%;display:grid;place-items:center;text-align:center;font-family:'Caveat',cursive;font-weight:700;font-size:1.35rem;padding:20px;color:var(--burgundy);line-height:1.05}
.bubble.salmon{background:var(--salmon);left:10%;top:18%}
.bubble.aqua{background:#78c5c1;right:10%;top:14%}
.bubble.yellow{background:var(--mustard);left:36%;bottom:4%}
.feature-meta{display:flex;gap:20px;font-size:.78rem;margin:18px 0;color:var(--muted)}
.count{font-size:.8rem;color:var(--muted);font-weight:700}
@media(max-width:850px){.feature{grid-template-columns:1fr}.feature>div:last-child{padding:0 8px 16px}.articles{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.articles{grid-template-columns:1fr}}
</style>
