{
  "name": "freelanceaiconsultant-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node -e \"require('fs').rmSync('node_modules/.astro',{recursive:true,force:true})\" && node scripts/generate-content-collections.mjs",
    "build": "astro build",
    "postbuild": "node planning/check-dist.mjs && node planning/check-nulmeting.mjs && node planning/check-rag.mjs",
    "nulmeting": "node planning/nulmeting.mjs",
    "check": "node planning/check-dist.mjs && node planning/check-nulmeting.mjs && node planning/check-rag.mjs && node planning/check-overflow.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "astro": "^5.13.5",
    "vanilla-cookieconsent": "3.1.0"
  },
  "devDependencies": {
    "node-html-parser": "^9.0.4",
    "playwright": "^1.64.1",
    "simple-icons": "^16.33.0"
  }
}
